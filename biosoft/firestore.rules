rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }
    // Un "aliado" (usuario de solo consulta de un convenio/empresa — ver
    // rol "aliado" en catalog.js/router.js) NUNCA debe tener el acceso
    // amplio de un miembro normal del laboratorio: por eso queda excluido
    // aquí a propósito, aunque su perfil sí apunte al mismo tenantId. Su
    // único acceso de lectura son las reglas puntuales que lo mencionan más
    // abajo (tenants, su propio documento en users, y orders filtradas por
    // su convenio) — nunca escritura de nada.
    function esDeEsteLab(tenantId) {
      return autenticado() && perfil().tenantId == tenantId && perfil().rol != "aliado";
    }
    function esSuperadmin() {
      return autenticado() && perfil().rol == "superadmin";
    }
    function esAliado(tenantId) {
      return autenticado() && perfil().tenantId == tenantId && perfil().rol == "aliado";
    }

    // Cada usuario autenticado solo puede leer SU PROPIO perfil (para saber a
    // qué laboratorio pertenece). Solo se crea una vez, al aprovisionar la
    // cuenta (el propio usuario recién creado escribe su documento). El
    // superadmin también puede leer/crear/corregir cualquier perfil, para
    // poder diagnosticar y reparar desde "Laboratorios Cliente" el caso de
    // una cuenta de Firebase Auth que quedó sin este documento (o apuntando
    // al laboratorio equivocado) — sin este acceso, ese enlace roto no se
    // puede arreglar de ninguna forma una vez creada la cuenta.
    match /userProfiles/{uid} {
      allow read: if (autenticado() && request.auth.uid == uid) || esSuperadmin();
      allow create: if (autenticado() && request.auth.uid == uid) || esSuperadmin();
      allow update: if esSuperadmin();
      allow delete: if false;
    }

    // CRM interno (leads y clientes de BIOsoft) — leer, editar y borrar solo
    // lo puede hacer el superadmin real. Crear también lo puede hacer
    // cualquier visitante SIN sesión desde el formulario público de
    // activación (activar.html): el cliente aún no tiene cuenta, así que se
    // valida que el documento nazca en estado "nuevo" y con la forma mínima
    // esperada, para evitar que se inyecten leads ya "activos" o corruptos.
    match /crmClientes/{clienteId} {
      allow read, update, delete: if esSuperadmin();
      allow create: if esSuperadmin() || (
        request.resource.data.estado == "nuevo" &&
        request.resource.data.origen == "formulario_publico" &&
        request.resource.data.laboratorio is map &&
        request.resource.data.contacto is map &&
        request.resource.data.contacto.nombre is string &&
        request.resource.data.contacto.nombre.size() > 0
      );
    }

    // Plantillas de mensajes de WhatsApp reutilizables del CRM — de uso
    // exclusivo del superadmin.
    match /crmPlantillas/{plantillaId} {
      allow read, write: if esSuperadmin();
    }

    // Imágenes de la landing pública (index.html) — cada documento es un
    // "espacio" de imagen de una sección (hero, funciones, precios, etc.).
    // Lectura pública SIN autenticación porque index.html es la página de
    // mercadeo, la ve cualquier visitante sin sesión. Solo el superadmin
    // (dueño de BIOsoft) puede subir o quitar imágenes.
    match /landingImagenes/{slotId} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /tenants/{tenantId} {
      // El superadmin necesita ver TODOS los laboratorios (panel "Laboratorios
      // Cliente"), no solo el propio — de ahí el esSuperadmin() en la lectura.
      // Un aliado también puede leer el documento del tenant (nombre/logo
      // para el encabezado de su portal), pero nada más de esta colección.
      allow read: if esDeEsteLab(tenantId) || esSuperadmin() || esAliado(tenantId);
      // El superadmin también puede actualizar (asignar/cambiar el plan y el
      // límite de usuarios de cada laboratorio desde el panel de socios).
      allow update: if esDeEsteLab(tenantId) || esSuperadmin();
      // La creación ocurre en el mismo flujo de aprovisionamiento, por el
      // usuario recién autenticado que se convertirá en su administrador.
      allow create: if autenticado();
      allow delete: if false;

      match /users/{userId} {
        // Un aliado solo puede leer SU PROPIO documento de usuario (para
        // saber a qué convenio quedó asignado al iniciar sesión) — nunca la
        // lista completa de usuarios del laboratorio.
        allow read: if esDeEsteLab(tenantId) || esSuperadmin() || (esAliado(tenantId) && userId == request.auth.uid);
        // El aprovisionamiento de CUALQUIER usuario real (ver
        // provisionRealAccount en store.js) crea este documento autenticado
        // como el usuario recién creado (no como quien lo está registrando),
        // así que un aliado necesita poder crear UNA VEZ su propio
        // documento — pero nunca actualizarlo después (para que no pueda
        // cambiarse a sí mismo el convenioId y leer resultados de un
        // convenio que no es el suyo).
        allow create: if esDeEsteLab(tenantId) || (esAliado(tenantId) && userId == request.auth.uid);
        // El superadmin del panel de socios solo puede tocar tres campos de
        // un usuario ya existente: "rol" (para "Restablecer Administrador",
        // darle también el rol de Administrador cuando el laboratorio se
        // quedó sin ninguno) y "permisosExtra"/"secciones" (para "Reparar
        // Permisos Operativos", cuando un laboratorio reporta fallas de
        // acceso de sus auxiliares/bacteriólogos) — nunca su contraseña,
        // firma ni ningún otro dato del usuario.
        allow update, delete: if esDeEsteLab(tenantId) ||
          (esSuperadmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rol", "permisosExtra", "secciones"]));
      }
      match /patients/{patientId} {
        allow read: if esDeEsteLab(tenantId) || esSuperadmin();
        allow write: if esDeEsteLab(tenantId);
      }
      // Un usuario de Recepción/Auxiliar con el permiso adicional
      // "Resultados" puede capturar/guardar resultados, pero NUNCA validar
      // ni firmar (ver views-results.js -> puedeValidar, y el comentario en
      // catalog.js -> PERMISOS_EXTRA_RECEPCION). Esa restricción antes solo
      // existía en el cliente (se podía saltar con una escritura directa a
      // Firestore); aquí se refuerza a nivel de reglas: ningún examen puede
      // pasar a "validado" o "remitido" por una escritura de este rol —
      // solo se permite si ese mismo examen (mismo examId) ya estaba en ese
      // estado en el documento existente, es decir, no lo "creó" esta
      // escritura.
      function esRecepcion() {
        return perfil().rol == "recepcion";
      }
      function examenesSinNuevasValidaciones(examenesNuevos, examenesViejos) {
        return examenesNuevos.all(e,
          !(e.estado in ["validado", "remitido"]) ||
          examenesViejos.exists(v, v.examId == e.examId && v.estado == e.estado)
        );
      }
      match /orders/{orderId} {
        // Un aliado solo puede leer las órdenes de SU convenio (comparando
        // resource.data.convenioId, el campo que views-orders.js graba en
        // cada orden) — nunca las de otro convenio ni las de un paciente
        // particular. Nunca puede escribir (no aparece en create/update).
        allow read: if esDeEsteLab(tenantId) || esSuperadmin() || (esAliado(tenantId) && perfil().convenioId == resource.data.convenioId);
        allow create: if esDeEsteLab(tenantId) && (
          !esRecepcion() || !request.resource.data.examenes.exists(e, e.estado in ["validado", "remitido"])
        );
        allow update: if esDeEsteLab(tenantId) && (
          !esRecepcion() || examenesSinNuevasValidaciones(request.resource.data.examenes, resource.data.examenes)
        );
        allow delete: if esDeEsteLab(tenantId);
      }
      match /auditLog/{logId} {
        // Un aliado nunca debe poder LEER la trazabilidad del laboratorio
        // (acciones de todo el personal), así que aquí se queda fuera a
        // propósito — pero sí necesita poder CREAR la única entrada que se
        // escribe al aprovisionar su propia cuenta (ver provisionRealAccount
        // en store.js, que la escribe autenticado como el usuario recién
        // creado). El superadmin también puede AGREGAR una entrada (nunca
        // editar ni borrar) — por ejemplo, al dejar registro de que
        // restableció el acceso de un laboratorio desde el panel de socios.
        allow read: if esDeEsteLab(tenantId) || esSuperadmin();
        allow create: if esDeEsteLab(tenantId) || esSuperadmin() || esAliado(tenantId);
        allow update, delete: if false;
      }
      match /qcControles/{controlId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /qcLecturas/{lecturaId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /preciosExamenes/{precioId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /examenesPersonalizados/{examenId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /cotizaciones/{cotizacionId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /reglasRemarketing/{reglaId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /remarketingContactos/{contactoId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /insumos/{insumoId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /recetasReactivos/{recetaId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /kardexInventario/{movimientoId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /ripsGenerados/{ripsId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /facturasGeneradas/{facturaId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /convenios/{convenioId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      match /convenioPrecios/{convenioPrecioId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      // Exámenes de laboratorio de referencia (ej. IDIME): precio de
      // compra y de venta de los exámenes que este laboratorio remite a un
      // tercero — catálogo independiente del catálogo interno de exámenes.
      match /examenesReferencia/{examenRefId} {
        allow read, write: if esDeEsteLab(tenantId);
      }
      // Consentimientos informados (Resolución 3100 de 2019): el paciente
      // puede firmarlo a distancia desde firmar.html, SIN iniciar sesión —
      // el id del documento (aleatorio, prácticamente imposible de
      // adivinar) es lo que protege el acceso, igual que un enlace de
      // firma electrónica de cualquier proveedor externo. Sin sesión solo
      // se puede pasar de "pendiente" a "firmado", escribiendo únicamente
      // los campos de la firma — nunca se puede reabrir uno ya firmado ni
      // tocar el resto del documento.
      match /consentimientos/{consentId} {
        allow read: if true;
        allow create, delete: if esDeEsteLab(tenantId);
        allow update: if esDeEsteLab(tenantId) || (
          resource.data.estado == "pendiente" &&
          request.resource.data.estado == "firmado" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "firmaPacienteDataUrl", "nombreFirmante", "documentoFirmante", "relacionFirmante", "fechaFirma"])
        );
      }
    }
  }
}
